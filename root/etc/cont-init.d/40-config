#!/usr/bin/with-contenv bash

if [ "$UT" != "true" ]; then
    echo 未设定自动更新trackers。
    exit 0
fi

work_dir=$(mktemp -d /tmp/qbittorrent-trackers.XXXXXX) || {
    echo 无法创建临时目录，跳过trackers更新。
    exit 0
}
trap 'rm -rf -- "$work_dir"' EXIT

tracker_list="$work_dir/trackers.txt"
config_file=/config/qBittorrent/config/qBittorrent.conf

download_trackers() {
    timeout -k 1 15 wget -t 1 -O "$tracker_list" -- "$TL" &&
        grep -q '[^[:space:]]' "$tracker_list"
}

if ! download_trackers && ! download_trackers; then
    echo 更新文件未正确下载，跳过trackers更新，请检查网络。
    exit 0
fi

new_trackers="Bittorrent\\TrackersList=$(awk '{sub(/\r$/, ""); if (NF) {printf "%s%s", separator, $0; separator="\\n"}}' "$tracker_list")"
old_trackers=$(grep '^Bittorrent\\TrackersList=' "$config_file")

if [ "$new_trackers" == "$old_trackers" ]; then
    echo trackers文件一样,不需要更新。
elif printf '%s\n' "$new_trackers" > "$work_dir/trackers.conf" &&
    sed -i -e '/^Bittorrent\\TrackersList=/r '"$work_dir/trackers.conf" \
        -e '/^Bittorrent\\TrackersList=/d' "$config_file"; then
    echo 已更新trackers。
else
    echo 无法写入配置，跳过trackers更新。
fi
